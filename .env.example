# ─── Contact Info ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=support@yourbrand.com
NEXT_PUBLIC_CONTACT_PHONE=+1 555 000 0000
NEXT_PUBLIC_CONTACT_PHONE_HREF=15550000000
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi! I'd like to learn more about your services.

# ─── Locations ─────────────────────────────────────────────────────────────────
# Format: comma-separated entries, each entry = "Label|Display Text"
# Use \, to escape commas inside an entry value.
NEXT_PUBLIC_LOCATIONS=USA|New York\, NY,UK|London\, United Kingdom

# ─── Social Media ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/company/yourbrand
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/yourbrand
NEXT_PUBLIC_SOCIAL_TWITTER=https://x.com/yourbrand
NEXT_PUBLIC_SOCIAL_REDDIT=https://reddit.com/r/yourbrand

# ─── Founder LinkedIn (for About page E-E-A-T signals) ─────────────────────────
NEXT_PUBLIC_FOUNDER_1_LINKEDIN=https://linkedin.com/in/manish-vaghamshi
NEXT_PUBLIC_FOUNDER_2_LINKEDIN=https://linkedin.com/in/meet-domadiya

# ─── Google Sheets Integration ─────────────────────────────────────────────────
# 1. Create a Google Sheet with two sheets named "Contact" and "Project"
# 2. Open Extensions → Apps Script and paste the code from docs/google-apps-script.js
# 3. Deploy as Web App (execute as: Me, access: Anyone)
# 4. Copy the deployment URL here
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# ─── Analytics ─────────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Leave unset or empty to disable GA entirely (e.g. in local dev)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─── Brand ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=YourBrand
